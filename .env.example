# --- Database -----------------------------------------------------------
# Local file (default). Point at a Turso URL for a hosted board.
TSBB_DATABASE_URL=file:./data/tsbb.db
# TSBB_DATABASE_URL=libsql://your-board.turso.io
# TSBB_DATABASE_AUTH_TOKEN=

# --- Board --------------------------------------------------------------
TSBB_BASE_URL=http://localhost:3000
TSBB_PORT=3000
TSBB_SESSION_SECRET=change-me-to-32-random-bytes

# --- Mail ---------------------------------------------------------------
# transport: resend | smtp | console
TSBB_MAIL_TRANSPORT=console
TSBB_MAIL_FROM=board@example.com
# RESEND_API_KEY=
# SMTP_URL=smtp://user:pass@host:587

# --- Uploads ------------------------------------------------------------
# Avatars are stored in the database, so there is nothing to configure and
# nothing to back up separately.

# --- Ads (CrawlProof) ---------------------------------------------------
# The ads plugin is enabled by default. Set your slot id from
# https://crawlproof.com/ads/slots — new slots are created INACTIVE and must be
# activated there before they serve anything.
TSBB_CRAWLPROOF_SLOT=
